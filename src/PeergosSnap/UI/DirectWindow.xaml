<Window x:Class="PeergosSnap.UI.DirectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Peergos Snap – Direct" Width="1180" Height="800" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen" AllowDrop="True">
    <Window.Resources>
        <Style x:Key="Dim" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Fg3}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Padding" Value="10,4"/></Style>
        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Padding" Value="10,4"/></Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="Margin" Value="0,1,6,0"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="10,3"/><Setter Property="MinWidth" Value="40"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- top bar: who and which month -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RefreshBtn" Content="Refresh" Margin="6,0,0,0" ToolTip="Look at the shared folders again"/>
                    <Button x:Name="FriendsBtn" Content="Friends…" Margin="6,0,0,0" ToolTip="Add friends, accept friend requests"/>
                </StackPanel>
                <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="FriendBox" Width="200" ToolTip="Whose files to show: all friends, or one"/>
                <TextBlock Text="Month" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox x:Name="MonthBox" Width="130" HorizontalAlignment="Left" ToolTip="All months, or one"/>
            </DockPanel>
        </Border>
        <!-- status line -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource Dim}"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Dim}"/>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="290"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>
            <!-- left: the drop zone and the shared files -->
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="10">
                    <Rectangle x:Name="DropFrame" RadiusX="10" RadiusY="10" StrokeThickness="2" StrokeDashArray="5 3"
                               Stroke="{DynamicResource Acc2}" Fill="{DynamicResource Bg2}"/>
                    <StackPanel Margin="16,14">
                        <DockPanel>
                            <ComboBox x:Name="SendToBox" DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" ToolTip="Who gets what you drop, paste or choose here"/>
                            <TextBlock x:Name="DropTitle" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Text="Send a picture" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,10"
                                   Text="Drop pictures, videos, files or folders here, paste them (Ctrl+V) or choose them. Your friend sees them at once."/>
                        <WrapPanel>
                            <Button x:Name="ChooseBtn" Content="Choose files…" Style="{DynamicResource AccentButtonStyle}"/>
                            <Button x:Name="FolderSendBtn" Content="Send a folder…" ToolTip="A folder travels as one ZIP file; your friend opens it as a folder with one click"/>
                            <Button x:Name="PasteBtn" Content="Paste" ToolTip="Send the picture or files on the clipboard (Ctrl+V)"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button x:Name="CaptureBtn" Content="Take picture" ToolTip="Select an area of the screen and send it"/>
                            <CheckBox x:Name="DrawFirstBox" Content="Draw first" VerticalAlignment="Center" Margin="4,0,0,6"
                                      ToolTip="Take picture opens the drawing editor first: add arrows, numbers or a note, then send it"/>
                        </WrapPanel>
                        <TextBlock x:Name="SendState" TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <ListBox x:Name="List" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="82" Height="58" CornerRadius="6" Background="{DynamicResource Bg3}" ClipToBounds="True" HorizontalAlignment="Left">
                                        <Grid>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Fg3}"/>
                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                            <Border Visibility="{Binding VideoBadge}" Background="#B0000000" CornerRadius="4" Padding="4,0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3">
                                                <TextBlock Text="▶" Foreground="White" FontSize="10"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Line2}" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Badges}" Foreground="{DynamicResource Acc}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="Empty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                               Style="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
                </Grid>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Line}" ResizeBehavior="PreviousAndNext"/>
            <!-- right: the file – viewing on top, the preview, then its details and what to do with it -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Padding="10,8,4,2" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button AutomationProperties.Name="View" x:Name="ViewBtn" ToolTip="Full screen, as in the history: the wheel zooms where the pointer is, the view follows the mouse, ← → go through the pictures and videos (double-click the picture)">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE740;"/><TextBlock Text="View"/></StackPanel>
                            </Button>
                            <ToggleButton x:Name="StarBtn" Content="☆ Star" ToolTip="Star it – your friend sees your star"/>
                            <ToggleButton x:Name="PinBtn" Content="📌 Pin" ToolTip="Pinned files stay at the top, for both of you"/>
                        </StackPanel>
                        <WrapPanel x:Name="ZoomBar">
                            <Button x:Name="ZoomOutBtn" Content="−" ToolTip="Zoom out (−, or the mouse wheel over the picture)" MinWidth="34"/>
                            <TextBlock x:Name="ZoomText" Width="58" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,6"/>
                            <Button x:Name="ZoomInBtn" Content="+" ToolTip="Zoom in (+, or the mouse wheel over the picture: it zooms where the pointer is)" MinWidth="34"/>
                            <Button x:Name="FitBtn" Content="Fit" ToolTip="The whole picture (F)"/>
                            <Button x:Name="ActualBtn" Content="100 %" ToolTip="Actual size (0)"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="12,8,12,6" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg2}">
                    <StackPanel>
                        <Border x:Name="ConfirmBar" Visibility="Collapsed" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Acc2}"
                                Background="{DynamicResource Bg}" Padding="12" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ConfirmYes" Content="Yes, delete" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,6,0"/>
                                    <Button x:Name="ConfirmNo" Content="Cancel" Margin="0"/>
                                </StackPanel>
                                <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="NameText" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="FactsText" TextWrapping="Wrap" Foreground="{DynamicResource Fg2}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="WhereText" TextWrapping="Wrap" Foreground="{DynamicResource Fg3}" Margin="0,2,0,8"/>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Label" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="LabelBox" ToolTip="A name or note for this file – your friend sees it too"/>
                        </DockPanel>
                        <WrapPanel x:Name="Actions">
                            <Button AutomationProperties.Name="Open" x:Name="OpenBtn" ToolTip="Open it in its app (Enter)">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;"/><TextBlock Text="Open"/></StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Folder" x:Name="FolderBtn" ToolTip="Show the file on this PC in its folder">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE838;"/><TextBlock Text="Folder"/></StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Save as…" x:Name="SaveBtn" ToolTip="Save a copy where you like on this PC">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;"/><TextBlock Text="Save as…"/></StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Copy" x:Name="CopyBtn" ToolTip="Copy it to the clipboard (a picture as a picture, anything else as a file)">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;"/><TextBlock Text="Copy"/></StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Draw on it" x:Name="DrawBtn" ToolTip="Draw on a copy – arrows, numbers, notes, highlights, blur – and send it back (the picture itself stays as it is)">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;"/><TextBlock Text="Draw on it"/></StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Open as folder" x:Name="UnpackBtn" ToolTip="Unpack the ZIP file next to it on this PC and open the folder">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;"/><TextBlock Text="Open as folder"/></StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Unpack to…" x:Name="UnpackToBtn" ToolTip="Unpack the ZIP file into a folder you choose">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8DE;"/><TextBlock Text="Unpack to…"/></StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Send to…" x:Name="ForwardBtn" ToolTip="Send it to another friend">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72D;"/><TextBlock Text="Send to…"/></StackPanel>
                                <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
                            </Button>
                            <Button AutomationProperties.Name="Get a link" x:Name="LinkBtn" ToolTip="Upload a copy to your own Peergos folder and copy a secret link – for someone who is not your friend in Peergos">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;"/><TextBlock Text="Get a link"/></StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Delete" x:Name="DeleteBtn" ToolTip="Delete your copy (in your Peergos and on this PC); your friend's copy stays theirs (Delete)">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;"/><TextBlock Text="Delete"/></StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Grid x:Name="Stage" Background="{DynamicResource Bg3}">
                    <!-- a picture: zoom with the wheel where the pointer is, drag to move, double-click for full screen -->
                    <ScrollViewer x:Name="Viewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image.LayoutTransform><ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/></Image.LayoutTransform>
                        </Image>
                    </ScrollViewer>
                    <!-- a video: its still first, ▶ plays it here -->
                    <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform"
                                  Visibility="Collapsed" Margin="0,0,0,52"/>
                    <Button x:Name="BigPlayBtn" Content="▶" FontSize="34" Width="86" Height="86" Visibility="Collapsed" Opacity="0.92"
                            HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Play (Space)"/>
                    <Border x:Name="PlayerBar" VerticalAlignment="Bottom" Visibility="Collapsed" Background="{DynamicResource Bg2}" Padding="10,8"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Button x:Name="PlayBtn" Content="▶" DockPanel.Dock="Left" Style="{StaticResource PlayerButton}" ToolTip="Play / pause (Space)"/>
                            <Button x:Name="MuteBtn" Content="🔊" DockPanel.Dock="Right" Style="{StaticResource PlayerButton}" ToolTip="Sound on / off"/>
                            <TextBlock x:Name="TimeText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource Fg2}"/>
                            <Slider x:Name="Seek" VerticalAlignment="Center" Margin="10,0,0,0" IsMoveToPointEnabled="True" IsEnabled="False" ToolTip="Go to a moment"/>
                        </DockPanel>
                    </Border>
                    <!-- any other file: what it is -->
                    <StackPanel x:Name="FileCard" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="20">
                        <TextBlock x:Name="FileGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="64" HorizontalAlignment="Center" Foreground="{DynamicResource Fg3}"/>
                        <TextBlock x:Name="FileTitle" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,4"/>
                        <TextBlock x:Name="FileFacts" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Fg2}"/>
                        <TextBlock x:Name="FileHint" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" Foreground="{DynamicResource Fg3}"/>
                        <TextBlock x:Name="FileList" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Fg2}" FontFamily="Cascadia Mono, Consolas"/>
                    </StackPanel>
                    <TextBlock x:Name="ViewerNote" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Dim}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" Margin="20"/>
                </Grid>
            </DockPanel>
            <!-- friends panel, over the window's right side -->
            <Border x:Name="FriendsPanel" Grid.Column="2" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Width="380"
                    Margin="0,8,12,0" Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Bg2}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="FriendsClose" DockPanel.Dock="Right" Content="✕" Margin="0" Padding="8,2" ToolTip="Close"/>
                        <TextBlock Text="Friends" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Add a friend by their Peergos username" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button x:Name="AddBtn" DockPanel.Dock="Right" Content="Add" Style="{DynamicResource AccentButtonStyle}" Margin="6,0,0,0"/>
                        <TextBox x:Name="AddBox"/>
                    </DockPanel>
                    <TextBlock x:Name="AddResult" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Fg2}"/>
                    <TextBlock x:Name="IncomingTitle" Text="Friend requests" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <StackPanel x:Name="IncomingList"/>
                    <TextBlock Text="Sharing directly with" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <StackPanel x:Name="FriendList"/>
                    <CheckBox x:Name="BringFront" Margin="0,12,0,0">
                        <TextBlock Text="Show this window when a friend sends something" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Only friends can share directly: a friend request has to be accepted once. Each of you then has a folder in Peergos (one per month) that only the two of you can see and change."/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
