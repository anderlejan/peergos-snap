<Window x:Class="PeergosSnap.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Peergos Snap – Settings" Width="820" Height="600" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,2,0,8"/><Setter Property="Padding" Value="3"/></Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}"><Setter Property="Margin" Value="0,2,0,8"/><Setter Property="Padding" Value="3"/></Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,4,0,6"/></Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}"><Setter Property="Margin" Value="0,3,16,3"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,2,0,8"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Fg3}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Opacity" Value="0.95"/></Style>
        <Style x:Key="Err" TargetType="TextBlock"><Setter Property="Foreground" Value="#C62828"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,3"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
        <!-- Categories in a column on the left (a page may get its own tabs on top later). -->
        <Style x:Key="NavTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="6">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                            <!-- the name lets screen readers (UI Automation) reach the selected page -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" Margin="10,0,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="14,9,18,9" Margin="0,1" Background="Transparent">
                            <Grid>
                                <Border x:Name="Bar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-10,3,0,3" Background="{DynamicResource Acc2}" Visibility="Hidden"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg3}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg3}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Acc}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="HelpBtn" DockPanel.Dock="Left" Content="Help" ToolTip="Help for this page (F1)" Margin="0,0,10,0"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center"
                       Text="Changes apply and are saved at once. The Peergos sign-in is stored encrypted for your Windows account."/>
        </DockPanel>
        <TabControl x:Name="Tabs" Style="{StaticResource NavTabs}">
            <TabItem Header="Peergos">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <TextBlock Text="Peergos account" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Sign in once. Every capture is then uploaded to your Peergos account and gets its own secret link, which is copied for you. Your password is only used to sign in and is not kept: Peergos Snap stays signed in (encrypted for your Windows account) until you sign out."/>
                    <StackPanel x:Name="SignedInPanel" Visibility="Collapsed" Margin="0,4,0,4">
                        <TextBlock x:Name="SignedInText" FontWeight="SemiBold" Foreground="{DynamicResource Acc}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="TestBtn" Content="Test connection"/>
                            <Button x:Name="SignOutBtn" Content="Sign out"/>
                        </StackPanel>
                        <TextBlock x:Name="TestResult" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="SignInPanel">
                        <TextBlock Text="Server"/>
                        <TextBox x:Name="Server"/>
                        <TextBlock Text="Username"/>
                        <TextBox x:Name="Username"/>
                        <TextBlock Text="Password"/>
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <PasswordBox x:Name="Password" Margin="0"/>
                            <TextBox x:Name="PasswordPlain" Margin="0" Visibility="Collapsed"/>
                            <ToggleButton x:Name="ShowPassword" Grid.Column="1" Margin="6,0,0,0" Padding="10,4" ToolTip="Show the password"
                                          AutomationProperties.Name="Show password">
                                <TextBlock x:Name="ShowPasswordGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7B3;"/>
                            </ToggleButton>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SignInBtn" Content="Sign in" Style="{DynamicResource AccentButtonStyle}" IsDefault="False"/>
                            <TextBlock x:Name="SignInResult" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="430"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Folder for captures (in your Peergos home, created when missing)" Margin="0,14,0,0"/>
                    <TextBox x:Name="AccountFolder"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Capture">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <TextBlock Text="A left click on the tray icon" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="KindPicture" Content="takes a picture" GroupName="kind"/>
                        <RadioButton x:Name="KindVideo" Content="starts / stops a video" GroupName="kind"/>
                    </StackPanel>
                    <TextBlock Text="Picture format"/>
                    <ComboBox x:Name="ImageFormat" Width="160" HorizontalAlignment="Left"><ComboBoxItem Content="png"/><ComboBoxItem Content="jpg"/></ComboBox>
                    <TextBlock Text="Video format"/>
                    <ComboBox x:Name="VideoFormat" Width="160" HorizontalAlignment="Left"><ComboBoxItem Content="mp4"/><ComboBoxItem Content="webm"/></ComboBox>
                    <TextBlock Text="Video frame rate (frames per second)"/>
                    <ComboBox x:Name="FrameRate" Width="160" HorizontalAlignment="Left"><ComboBoxItem Content="15"/><ComboBoxItem Content="24"/><ComboBoxItem Content="30"/><ComboBoxItem Content="60"/></ComboBox>
                    <TextBlock x:Name="QualityLabel" Text="Video quality"/>
                    <Slider x:Name="Quality" Minimum="15" Maximum="40" Width="300" HorizontalAlignment="Left" IsDirectionReversed="True" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,2"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Left = smaller files, right = sharper (x264 CRF 40 … 15, default 23)."/>
                    <CheckBox x:Name="RecordCursor" Content="Show the mouse pointer in videos"/>
                    <CheckBox x:Name="RecordSound" Content="Record the sound Windows plays (only when there is any)"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Everything you hear from this PC – videos, games, calls, notification sounds – goes into the video. A recording during which Windows played nothing gets no sound track. Your microphone is not recorded."/>
                    <TextBlock Text="Delay before capturing (seconds, 0 = none, up to 60)" Margin="0,10,0,0"/>
                    <TextBox x:Name="DelayBox" Width="120" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="DelayBoxErr" Style="{StaticResource Err}" Visibility="Collapsed" Text="A whole number from 0 to 60"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Pictures: after the countdown the screen freezes and you select the area – open a menu during the countdown and it stays in the picture. Videos: you select the area first; recording starts when the countdown ends. The tray menu offers 1–5 seconds quickly (Delay ▸)."/>
                    <CheckBox x:Name="AskPicture" Content="After a picture, ask what to do (upload, copy, save as or discard)"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Overlay">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <TextBlock Style="{StaticResource Hint}" Text="The selection never freezes the screen: games, virtual worlds and videos keep moving while you drag. The picture is taken the moment you release the mouse."/>
                    <TextBlock x:Name="DimLabel" Text="Darken outside the selection"/>
                    <Slider x:Name="Dim" Minimum="0" Maximum="70" Width="300" HorizontalAlignment="Left" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,2,0,8"/>
                    <TextBlock Text="Border colour (e.g. #FF3B30 or Lime)"/>
                    <TextBox x:Name="BorderColor" Width="160" HorizontalAlignment="Left"/>
                    <CheckBox x:Name="ShowSize" Content="Show the size while dragging"/>
                    <CheckBox x:Name="PickWindow" Content="A click without dragging takes the window under the pointer"/>
                    <TextBlock Text="Extra wait after releasing the mouse (milliseconds, 0 = instant)"/>
                    <TextBox x:Name="Delay" Width="160" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="DelayErr" Style="{StaticResource Err}" Visibility="Collapsed"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Output">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <TextBlock Text="After a capture" FontWeight="SemiBold"/>
                    <RadioButton x:Name="OutLink" Content="Upload to Peergos and copy the secret link" GroupName="out"/>
                    <RadioButton x:Name="OutMedia" Content="Copy the picture / video itself to the clipboard (no upload)" GroupName="out"/>
                    <CheckBox x:Name="Fallback" Content="If the upload fails, copy the picture / video to the clipboard instead" Margin="0,10,0,6"/>
                    <CheckBox x:Name="Notifications" Content="Show notifications"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Files &amp; history">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <TextBlock Text="Captures on this PC" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Local captures folder (every capture is kept here)" Margin="0,0,0,2"/>
                    <DockPanel>
                        <Button x:Name="CacheOpen" DockPanel.Dock="Right" Content="📂" ToolTip="Open the folder" Margin="6,0,0,0"/>
                        <TextBlock x:Name="CachePath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="Sort into subfolders" Margin="0,10,0,0"/>
                    <ComboBox x:Name="SubfolderBox" Width="260" HorizontalAlignment="Left">
                        <ComboBoxItem Tag="Month" Content="One folder per month (2026-10)"/>
                        <ComboBoxItem Tag="Day" Content="One folder per day (2026-10-05)"/>
                        <ComboBoxItem Tag="Year" Content="One folder per year (2026)"/>
                        <ComboBoxItem Tag="None" Content="No subfolders"/>
                    </ComboBox>
                    <TextBlock Style="{StaticResource Hint}" Text="Used for the captures folder and for the mirror folder below. Captures already saved stay where they are."/>
                    <TextBlock Text="Keep a copy on this PC" Margin="0,4,0,0"/>
                    <ComboBox x:Name="KeepCopiesBox" Width="320" HorizontalAlignment="Left">
                        <ComboBoxItem Tag="Always" Content="Always"/>
                        <ComboBoxItem Tag="OnlyIfUploadFails" Content="Only if the upload fails"/>
                    </ComboBox>
                    <TextBlock Style="{StaticResource Hint}" Text="'Only if the upload fails' deletes the copy in the captures folder as soon as the capture is in Peergos; the history keeps its link. Captures that are only copied to the clipboard or kept on this PC stay. The mirror folder below is a separate choice."/>
                    <CheckBox x:Name="DiscardPerm" Content="Discarded captures are deleted at once, never kept (no Recycle Bin)"/>
                    <TextBlock Style="{StaticResource Hint}" Text="On by default: 'Discard' leaves nothing behind – on this PC, in the mirror folder, in Peergos or in the history. Off moves discarded files to the Recycle Bin instead."/>
                    <TextBlock Text="Delete local copies older than (days, 0 = keep forever)"/>
                    <TextBox x:Name="KeepDays" Width="120" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Keep forever is the default. If you set a number, older copies go to the Recycle Bin, so nothing is lost by accident."/>
                    <CheckBox x:Name="MirrorOn" Content="Also save every capture to this folder:" Margin="0,10,0,2"/>
                    <DockPanel>
                        <Button x:Name="MirrorOpen" DockPanel.Dock="Right" Content="📂" ToolTip="Open the folder" Margin="6,2,0,8"/>
                        <Button x:Name="MirrorBrowse" DockPanel.Dock="Right" Content="Choose…" Margin="6,2,0,8"/>
                        <TextBox x:Name="MirrorFolder"/>
                    </DockPanel>
                    <TextBlock x:Name="MirrorErr" Style="{StaticResource Err}" Visibility="Collapsed"/>
                    <TextBlock Text="History" FontWeight="SemiBold" Margin="0,14,0,4"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Every capture is listed in the history with its preview, label, link and where it is (this PC, Peergos). There you can find old links again, add labels and delete what you no longer need – on this PC, in Peergos or both."/>
                    <Button x:Name="OpenHistoryBtn" Content="Open history" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <CheckBox x:Name="RememberApp" Content="Remember which app each capture came from"/>
                    <TextBlock Text="Delete key in the history" Margin="0,8,0,0"/>
                    <ComboBox x:Name="HistoryDeleteBox" Width="320" HorizontalAlignment="Left">
                        <ComboBoxItem Tag="Both" Content="Delete from this PC and Peergos"/>
                        <ComboBoxItem Tag="Local" Content="Delete from this PC"/>
                        <ComboBoxItem Tag="Peergos" Content="Delete from Peergos"/>
                        <ComboBoxItem Tag="Entry" Content="Only remove the history entry"/>
                    </ComboBox>
                    <TextBlock Style="{StaticResource Hint}" Text="The Delete key does this for the selected captures, always after a confirmation; its button is highlighted."/>
                    <CheckBox x:Name="BothRemovesEntry" Content="Deleting from this PC and Peergos also removes the entry from the history"/>
                    <TextBlock Style="{StaticResource Hint}" Text="On by default. Off keeps the entry, without files, so you still see what you deleted."/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Direct">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <TextBlock Text="Pictures straight to a friend" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Hint}" Text="While you talk with someone in another app, send a picture by dropping or pasting it into the direct window (or tray menu → Direct to a friend → Send a picture). It appears on your friend's screen within seconds, in a window where both of you can zoom, save, label, pin or star it; you can delete what you sent for both of you, and what you received on your side. Each file is shared read-only with that friend only. You both need to be signed in to Peergos with Peergos Snap running, and be friends in Peergos (a friend request accepted once)."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="OpenDirectBtn" Content="Open the direct window" Style="{DynamicResource AccentButtonStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="DirectInfo" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <CheckBox x:Name="DirectReceive" Content="Receive pictures from friends at once"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Keeps a connection to Peergos open in the background while you share with friends (it uses some memory). Off: pictures from friends only arrive while the direct window is open."/>
                    <CheckBox x:Name="DirectFront" Content="Show the direct window when a friend sends something"/>
                    <TextBlock Style="{StaticResource Hint}" Text="It comes to the front without taking the keyboard from the app you are typing in. Off: only a notification card."/>
                    <TextBlock Text="Check for new pictures every (seconds, 2 to 60)"/>
                    <TextBox x:Name="DirectSeconds" Width="120" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="DirectSecondsErr" Style="{StaticResource Err}" Visibility="Collapsed" Text="A whole number from 2 to 60"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Where the pictures are: in Peergos, in PeergosSnap-Direct/(friend)/(month) of each of you; on this PC, a copy of everything you open or receive in the Direct folder next to the captures folder."/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <TextBlock Style="{StaticResource Hint}" Text="Click a box and press the keys (with Ctrl, Alt, Shift or Win). Backspace or Delete clears it."/>
                    <TextBlock Text="Take picture"/>
                    <TextBox x:Name="HkPicture" Width="240" HorizontalAlignment="Left" IsReadOnly="True"/>
                    <TextBlock x:Name="HkPictureErr" Style="{StaticResource Err}" Visibility="Collapsed"/>
                    <TextBlock Text="Record video / stop recording"/>
                    <TextBox x:Name="HkVideo" Width="240" HorizontalAlignment="Left" IsReadOnly="True"/>
                    <TextBlock x:Name="HkVideoErr" Style="{StaticResource Err}" Visibility="Collapsed"/>
                    <TextBlock Text="Pause / resume recording"/>
                    <TextBox x:Name="HkPause" Width="240" HorizontalAlignment="Left" IsReadOnly="True"/>
                    <TextBlock x:Name="HkPauseErr" Style="{StaticResource Err}" Visibility="Collapsed"/>
                    <TextBlock Text="Switch output (secret link ↔ clipboard)"/>
                    <TextBox x:Name="HkOutput" Width="240" HorizontalAlignment="Left" IsReadOnly="True"/>
                    <TextBlock x:Name="HkOutputErr" Style="{StaticResource Err}" Visibility="Collapsed"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <TextBlock Text="Colour scheme"/>
                    <ComboBox x:Name="SchemeBox" Width="320" HorizontalAlignment="Left" DisplayMemberPath="Name" MaxDropDownHeight="520">
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Fg3}" Margin="10,8,0,2"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                    </ComboBox>
                    <TextBlock Style="{StaticResource Hint}" Text="Dark, medium and bright schemes. They are used by every window of the app: Settings, Help, User notes, the tray menu, the recording bar, dialogs and notifications. 'Follow Windows' uses Peergos light or dark to match Windows."/>
                    <TextBlock x:Name="FontLabel" Text="Font size" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="FontSlider" Minimum="80" Maximum="160" Width="300" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,2,10,8"/>
                        <Button x:Name="FontReset" Content="100 %" ToolTip="Back to the normal size"/>
                    </StackPanel>
                    <Border x:Name="Preview" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Bg2}" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Preview" FontWeight="SemiBold"/>
                            <TextBlock Text="Link copied to the clipboard – paste it with Ctrl+V." Foreground="{DynamicResource Fg2}" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Normal button"/>
                                <Button Content="Accent button" Style="{DynamicResource AccentButtonStyle}"/>
                                <CheckBox Content="Option" IsChecked="True" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <CheckBox x:Name="Autostart" Content="Start Peergos Snap when I sign in to Windows"/>
                    <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,10,0,2"/>
                    <CheckBox x:Name="AutoCheck" Content="Check for new versions automatically (at start and once a day)"/>
                    <CheckBox x:Name="AutoInstall" Content="Install new versions automatically (never during a recording or upload)"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="CheckUpdateBtn" Content="Check for the new version"/>
                        <Button x:Name="InstallUpdateBtn" Content="Install now" Style="{DynamicResource AccentButtonStyle}" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateResult" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <CheckBox x:Name="ShowNotes" Content="Show 'User notes…' in the tray menu"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                        <Button x:Name="OpenNotes" Content="Open User notes"/>
                        <Button x:Name="OpenLog" Content="Open log"/>
                        <Button x:Name="OpenLicenses" Content="Licenses"/>
                    </StackPanel>
                    <TextBlock Text="User notes" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Keep a list of wanted changes while you test: fixes, adjustments, new ideas and questions. Tick notes to queue them, then make a Full prompt (everything a new AI session needs), a Short prompt (only the changes, for the same session) or plain User feedback. Statuses (open → queued → sent → done) change only by hand: use 'Mark these N as Sent' after you really sent a prompt. With notes ticked, a bar under the list changes type, area, priority or status of all of them. The Done filter lists finished work for printing or PDF. Ctrl+Z (outside text fields) brings back the last deletions."/>
                    <TextBlock Text="Source location for AI prompts (optional)" Margin="0,8,0,0"/>
                    <TextBox x:Name="PromptLocation"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Only if you work on Peergos Snap's source yourself: a folder or repository address that Full prompts should name. Stays on this PC. Empty = a general description without any names or paths."/>
                    <TextBlock x:Name="About" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
