<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PeergosSnap</RootNamespace>
    <AssemblyName>PeergosSnap</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PeergosSnap.ico</ApplicationIcon>
    <Version>2.4.0</Version>
    <Product>Peergos Snap</Product>
    <Company>anderlejan</Company>
    <Copyright>Copyright (C) 2026 anderlejan. GPL-3.0-or-later.</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Release binaries must not contain the build machine's folders: neutral source paths, no debug symbols shipped. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/src/PeergosSnap</PathMap>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <!-- System sound for videos (WASAPI loopback). MIT licence, see THIRD-PARTY-NOTICES.md. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PeergosSnap.ico" />
    <EmbeddedResource Include="Assets\shutter.wav" LogicalName="PeergosSnap.Assets.shutter.wav" />
    <Content Include="usernotes\usernotes-core.js;usernotes\usernotes-ui.js;usernotes\usernotes.css;notes-host\**\*;help\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="usernotes\README.md;usernotes\usernotes-store.js;usernotes\usernotes.test.js" />
  </ItemGroup>

</Project>
